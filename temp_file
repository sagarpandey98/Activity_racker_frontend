import axios from 'axios';
import { getUserId } from '@/lib/utils/authUtils';

const trackerClient = axios.create({
  baseURL: '/api/tracker',
  headers: {
    'Content-Type': 'application/json',
  },
  withCredentials: true, // send cookies automatically
});

// Request interceptor — attach JWT token and user ID from cookie
trackerClient.interceptors.request.use(
  (config) => {
    // Token is in httpOnly cookie, handled server-side
    // Add X-User-Id header for smart todo endpoints
    if (config.url?.includes('/todos/')) {
      const userId = getUserId();
      if (userId) {
        config.headers = {
          ...config.headers,
          'X-User-Id': userId
        };
        console.log('Adding X-User-Id header:', userId);
      } else {
        console.warn('Could not extract user ID for smart todo API');
      }
    }
    return config;
  },
  (error) => Promise.reject(error)
);

// Response interceptor — handle 401 globally
trackerClient.interceptors.response.use(
  (response) => response,
  (error) => {
    if (error.response?.status === 401) {
      // Token expired or invalid
      console.warn('Authentication failed - redirecting to login');
      // Redirect to login
      if (typeof window !== 'undefined') {
        window.location.href = '/login';
      }
    }
    const message =
      error.response?.data?.message ||
      error.response?.data?.error ||
      'Something went wrong';
    return Promise.reject(new Error(message));
  }
);

export default trackerClient;
